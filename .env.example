# Copy this file to ".env" and fill in your keys.

# Groq API key — get a free one at https://console.groq.com/keys
GROQ_API_KEY=

# Tavily API key — get a free one at https://app.tavily.com/
TAVILY_API_KEY=

# Groq model id. IMPORTANT: confirm a currently-served model at
# https://console.groq.com/docs/models — the default below may be deprecated.
GROQ_MODEL=openai/gpt-oss-120b

# Optional tuning
TEMPERATURE=0.3
MAX_SEARCH_RESULTS=5
MAX_SUBQUESTIONS=5
MAX_FACTCHECK_RETRIES=1
